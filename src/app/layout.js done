:root {
  --bg: #fffaf0;
  --surface: #ffffff;
  --brand: #0b2f57;
  --brand-soft: #123f6d;
  --accent: #c99a2e;
  --text: #1f2933;
  --muted: #667085;
  --border: #eadfca;
  --shadow: 0 18px 45px rgba(11, 47, 87, 0.12);
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  background: var(--bg);
  color: var(--text);
  font-family: Arial, Helvetica, sans-serif;
}

a {
  color: inherit;
  text-decoration: none;
}

main {
  min-height: 100vh;
}

.container {
  width: min(1120px, calc(100% - 32px));
  margin: 0 auto;
}

.site-header {
  position: sticky;
  top: 0;
  z-index: 50;
  background: rgba(255, 250, 240, 0.94);
  border-bottom: 1px solid var(--border);
  backdrop-filter: blur(12px);
}

.header-inner {
  min-height: 74px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
}

.brand {
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.brand-title {
  color: var(--brand);
  font-size: 22px;
  font-weight: 800;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}

.brand-subtitle {
  color: var(--muted);
  font-size: 12px;
}

.nav {
  display: flex;
  align-items: center;
  gap: 18px;
  color: var(--brand);
  font-size: 14px;
  font-weight: 700;
}

.nav a:hover {
  color: var(--accent);
}

.hero {
  padding: 72px 0 56px;
}

.hero-grid {
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  gap: 42px;
  align-items: center;
}

.eyebrow {
  color: var(--accent);
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  font-size: 13px;
  margin-bottom: 14px;
}

.hero h1 {
  margin: 0;
  color: var(--brand);
  font-size: clamp(38px, 5vw, 64px);
  line-height: 1.04;
  letter-spacing: -0.04em;
}

.hero p {
  margin: 22px 0 0;
  color: #344054;
  font-size: 18px;
  line-height: 1.75;
  max-width: 650px;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 14px;
  margin-top: 30px;
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 46px;
  padding: 0 20px;
  border-radius: 999px;
  font-weight: 800;
  border: 1px solid transparent;
}

.btn-primary {
  background: var(--brand);
  color: white;
  box-shadow: var(--shadow);
}

.btn-secondary {
  background: white;
  color: var(--brand);
  border-color: var(--border);
}

.hero-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 28px;
  padding: 30px;
  box-shadow: var(--shadow);
}

.hero-card h2 {
  margin: 0 0 14px;
  color: var(--brand);
  font-size: 26px;
}

.hero-card ul {
  margin: 0;
  padding-left: 20px;
  color: #344054;
  line-height: 2;
}

.section {
  padding: 54px 0;
}

.section-heading {
  max-width: 720px;
  margin-bottom: 28px;
}

.section-heading h2 {
  margin: 0;
  color: var(--brand);
  font-size: clamp(28px, 3vw, 42px);
  letter-spacing: -0.03em;
}

.section-heading p {
  color: var(--muted);
  font-size: 17px;
  line-height: 1.7;
}

.cards {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18px;
}

.card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 22px;
  padding: 24px;
  box-shadow: 0 10px 28px rgba(11, 47, 87, 0.07);
}

.card h3 {
  margin: 0 0 10px;
  color: var(--brand);
  font-size: 20px;
}

.card p {
  margin: 0;
  color: var(--muted);
  line-height: 1.65;
}

.process {
  counter-reset: step;
}

.step {
  position: relative;
}

.step::before {
  counter-increment: step;
  content: "0" counter(step);
  display: inline-flex;
  margin-bottom: 18px;
  color: var(--accent);
  font-weight: 900;
  font-size: 26px;
}

.contact-box {
  background: var(--brand);
  color: white;
  border-radius: 28px;
  padding: 34px;
  display: grid;
  grid-template-columns: 1.2fr 0.8fr;
  gap: 24px;
  align-items: center;
}

.contact-box h2 {
  margin: 0;
  font-size: 34px;
  letter-spacing: -0.03em;
}

.contact-box p {
  color: rgba(255, 255, 255, 0.78);
  line-height: 1.7;
}

.contact-actions {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.contact-actions .btn {
  background: white;
  color: var(--brand);
}

.site-footer {
  border-top: 1px solid var(--border);
  padding: 26px 0;
  color: var(--muted);
  text-align: center;
}

@media (max-width: 840px) {
  .header-inner {
    align-items: flex-start;
    padding: 16px 0;
    flex-direction: column;
  }

  .nav {
    flex-wrap: wrap;
    gap: 12px;
  }

  .hero {
    padding-top: 44px;
  }

  .hero-grid,
  .contact-box {
    grid-template-columns: 1fr;
  }

  .cards {
    grid-template-columns: 1fr;
  }
}
